{:paths ["resources" "src" "classes"]
 :deps {org.clojure/clojure {:mvn/version "1.10.1"}
        org.clojure/core.match {:mvn/version "1.0.0"}
        org.clojure/core.cache {:mvn/version "1.0.207"}
        net.jpountz.lz4/lz4 {:mvn/version "1.3.0"}
        ;; jline 2 bundled its own copy of jansi's classes, which shadowed the
        ;; real one on the classpath and had no native library for any arm64
        ;; platform. jline 3 ships no such copy, and jansi 2.4 carries natives
        ;; for Mac, Linux and Windows on arm64 as well as x86.
        org.jline/jline {:mvn/version "3.26.3"}
        org.fusesource.jansi/jansi {:mvn/version "2.4.1"}
        jansi-clj/jansi-clj {:mvn/version "2.0.1"}
        net.java.dev.jna/jna {:mvn/version "4.2.2"}
        net.java.dev.jna/jna-platform {:mvn/version "4.2.2"}
        org.clojure/core.async {:mvn/version "0.4.490"}
        progress/progress {:mvn/version "1.0.2"}
        org.clojure/data.json {:mvn/version "0.2.6"}
        me.raynes/fs {:mvn/version "1.4.6"}
        clj-http/clj-http {:mvn/version "2.3.0"}
        com.taoensso/timbre {:mvn/version "4.8.0"}
        org.clojure/tools.cli {:mvn/version "0.3.5"}
        com.rpl/specter {:mvn/version "1.1.0"}
        instaparse/instaparse {:mvn/version "1.4.8"}
        kmp-search/kmp-search {:mvn/version "0.1.2"}
        expound/expound {:mvn/version "0.8.4"}
        org.flatland/ordered {:mvn/version "1.5.9"}
        org.clojure/data.csv {:mvn/version "1.0.1"}
        cpath-clj/cpath-clj {:mvn/version "0.1.2"}
        }
 :aliases
 {;; Runs only the namespaces named on the command line. The older test files
  ;; under test/ predate this and depend on boot and midje, neither of which is
  ;; a dependency any more, so a blanket runner would fail before reaching
  ;; anything current.
  :test {:extra-paths ["test"]}

  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.9.0" :git/sha "8c93e0c"}
                 me.raynes/fs {:mvn/version "1.4.6"}
                 digest/digest {:mvn/version "1.4.5"}
                 }
          :ns-default build}}
 }
